# Copie para .env e preencha. O .env nunca é commitado (PRD §9.1).
# Em produção, estes três viram GitHub Secrets.

# Conta Gmail que envia o e-mail
EMAIL_REMETENTE=voce@gmail.com

# Senha de Aplicativo do Gmail (16 caracteres, NÃO é a senha da conta).
# Gere em https://myaccount.google.com/apppasswords com a verificação em 2 etapas ativa.
SENHA_APP_GMAIL=xxxxxxxxxxxxxxxx

# Quem recebe o e-mail. Destinatário único, sem CC nem BCC (RN17).
EMAIL_DESTINO=voce@gmail.com

# Abaixo deste número de parceiros extraídos, a execução falha de propósito (RF12, RN13).
# A página tinha 247 parceiros na conferência de 2026-08-09.
LIMIAR_PARCEIROS=150

# Conexao do Neon (Postgres). Credencial: nunca commitar, nunca colar em chat.
# Copie do painel do Neon em Connection Details.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

# --- Site (site/, V2.3). Na Vercel, viram Environment Variables. ---

# Senha unica de edicao do site (PRD-V2 §9.0). Longa e aleatoria: e credencial
# de vida longa, sem segundo fator. Nunca no codigo, nunca no repositorio.
SENHA_SITE=troque-por-algo-longo-e-aleatorio

# Segredo que assina o cookie de sessao. Independente da senha: trocar um nao
# obriga a trocar o outro, e trocar este derruba as sessoes abertas.
SEGREDO_SESSAO=outro-valor-longo-e-aleatorio
