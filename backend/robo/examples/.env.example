# Robos Python — copie para backend/robo/.env apenas no desenvolvimento local.
# No GitHub Actions, os valores sensiveis ficam em Actions Secrets.

# Obrigatoria para os coletores Inter. Na Livelo, habilita catalogo e retrato no
# Postgres; sem ela, somente a Livelo pode usar o TOML como reserva.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

# Configuracoes nao secretas. Os valores abaixo sao os padroes dos workflows.
LIMIAR_PARCEIROS=150
LIMIAR_LOJAS_INTER=100

# Opcional. Relativo ao diretorio backend/robo quando nao for caminho absoluto.
CAMINHO_CONFIG=config/lojas_favoritas.toml
