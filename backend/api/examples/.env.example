# API Next.js — copie somente para desenvolvimento local.
# Em producao, cadastre estas chaves na Vercel. Nunca commite valores reais.

# Credencial do Neon/Postgres. Segredo obrigatorio.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

# Identificador publico do projeto usado pelo Firebase Admin.
FIREBASE_PROJECT_ID=radarbeneficios

# Conta de servico Firebase Admin em JSON, numa unica linha. Segredo obrigatorio
# na Vercel quando Application Default Credentials nao estiver disponivel.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"radarbeneficios","private_key":"NAO_USE_ESTE_EXEMPLO","client_email":"exemplo@radarbeneficios.iam.gserviceaccount.com"}

# Chave aleatoria para pseudonimizar IP e UID no rate limit. Segredo obrigatorio.
SEGREDO_LIMITE_API=troque-por-um-valor-longo-e-aleatorio

# Token fine-grained usado somente para disparar workflows conhecidos.
# Segredo; permissao minima de Actions no repositorio deste projeto.
GITHUB_TOKEN_DISPARO=github_pat_exemplo

# Flags e listas publicas de configuracao do servidor.
EXIGIR_APP_CHECK=false
ALLOWED_ORIGINS=

# Diagnostico temporario. Manter ausente ou false em producao, pois o modo true
# registra ate 200 caracteres da mensagem devolvida pelo Firebase.
DEBUG_AUTH=false
